# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (bKash callbacks, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for /api/cron/* (random string, e.g. `openssl rand -hex 32`)
CRON_SECRET=

# Optional fallbacks - normally configured in Dashboard > Settings
BKASH_API_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
PATHAO_API_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
STEADFAST_BASE_URL=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
